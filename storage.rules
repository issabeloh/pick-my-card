rules_version = '2';

// Pick My Card — Firebase Storage 安全規則
//
// 這份檔案是「唯一正確版本」（版本控管在 git）。修改後要貼到 console 才會生效：
//   Firebase console → Storage → 規則（Rules）→ 貼上 → 發布
// 改完先跑模擬器測試 tools/firestore-rules-test.js（同一支也測 Storage，用法見檔頭）。
// ⚠️ firestore.rules 的封鎖名單（notBlocked）有變動時，這裡要同步。
//
// 網站唯一的上傳：意見回報附圖（js/quick-options-misc.js，需登入）
//   路徑 feedback/<uid>_<台灣日期 20261003>_<今天第幾則 1-5>_<第幾張 0-2>.jpg，前端壓成 JPEG、2MB 以下
//   日期必須是今天、不能覆蓋 → 每帳號每天最多 15 張（5 則 × 3 張），與 firestore.rules 的回報額度一致
//   上傳後呼叫 getDownloadURL（需要 read 權限）取得網址存進 feedback 文件
// 站長在 console 看圖不受規則限制。

service firebase.storage {
  match /b/{bucket}/o {

    // 同 firestore.rules 的封鎖名單（2026-10-01 腳本狂寫事件）
    function notBlocked() {
      return !(request.auth.uid in ['GNEzbVzqwGh9UkMfvo4fPwXAmZy2', 'bQzrQFDmyCQrZ3AapnG10Ff8avh2']);
    }

    // 台灣時間的「今天」，格式 20261003（與 firestore.rules 的 todayKey 相同）
    function todayKey() {
      let t = request.time + duration.value(8, 'h');
      return t.year() * 10000 + t.month() * 100 + t.day();
    }

    function todaySlotFile(fileName) {
      return fileName.matches(request.auth.uid + '_' + string(todayKey()) + '_[1-5]_[0-2][.]jpg');
    }

    match /feedback/{fileName} {
      // 只能新增、不能覆蓋或刪除；限 JPEG、2MB 以下
      allow create: if request.auth != null && notBlocked()
                    && todaySlotFile(fileName)
                    && resource == null
                    && request.resource.size < 2 * 1024 * 1024
                    && request.resource.contentType == 'image/jpeg';
      allow read: if request.auth != null && notBlocked()
                  && fileName.matches(request.auth.uid + '_.*[.]jpg');
      allow update, delete: if false;
    }

    // 其他一律拒絕
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
